<Project>

  <!--
    Central Package Management: every NuGet version is declared here once, and
    project files reference packages without a Version attribute:

        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    This makes version skew across nine projects impossible by construction,
    and a dependency upgrade a one-line diff in one file.

    Versions are added as each phase needs them rather than speculatively —
    an unused pinned dependency is still a dependency you are on the hook for.
    See the pending ADR-0004 on dependency governance for why MediatR,
    AutoMapper and FluentAssertions are deliberately absent.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Populated in Phase 1">
    <!-- EF Core + Npgsql, ASP.NET Core Identity, Serilog, FluentValidation,
         Scrutor, Scalar, xUnit v3, Shouldly, Testcontainers, Respawn,
         NetArchTest. -->
  </ItemGroup>

</Project>
