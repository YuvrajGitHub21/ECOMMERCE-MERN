<Project>
  <!--
    Central Package Management: every NuGet version is declared here once, and
    project files reference packages without a Version attribute:

        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    This makes version skew across nine projects impossible by construction,
    and a dependency upgrade a one-line diff in one file.

    Versions are added as each phase needs them rather than speculatively —
    an unused pinned dependency is still a dependency you are on the hook for.
    See ADR-0004 on dependency governance for why MediatR, AutoMapper and
    FluentAssertions are deliberately absent.

    Every version here was resolved by `dotnet add package` rather than typed
    from memory. Asset metadata (IncludeAssets/PrivateAssets) belongs on the
    PackageReference in the consuming project, not here — this file's job is
    versions and nothing else.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    xUnit v3 runs on Microsoft.Testing.Platform, and the .NET 10 SDK removed VSTest
    support for MTP projects. The whole VSTest package set — Microsoft.NET.Test.Sdk,
    xunit.runner.visualstudio and coverlet.collector — is therefore absent by design,
    not by oversight: xunit.v3 carries the runner itself. The opt-in lives in
    global.json, and TRX and coverage come from MTP extensions added in the CI task.
  -->
  <ItemGroup Label="Application">
    <!--
      FluentValidation, not FluentAssertions. The names are close enough to be worth
      stating: FluentAssertions v8 moved to a commercial licence and is banned by
      ADR-0004, while FluentValidation remains Apache-2.0 and is used freely here.
    -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- Assembly scanning and, more importantly, open-generic Decorate<> for the
         handler pipeline. Replaces the part of MediatR that ADR-0004 rules out. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <!--
      snake_case table and column names come from EFCore.NamingConventions, NOT from
      Npgsql. Easy to assume otherwise, and the failure mode is a database full of
      PascalCase identifiers that every hand-written SQL statement then has to quote.
    -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- SMTP client for the verification and reset emails. MailKit, not System.Net.Mail's
         SmtpClient, which Microsoft documents as obsolete for new work and which does not
         handle modern TLS negotiation properly. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <!-- Signs access tokens. The modern handler, not the older System.IdentityModel.Tokens.Jwt
         one: same tokens, measurably faster, and the type the JwtBearer stack now uses itself. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <!-- Design-time only: it carries the migrations tooling and must never ship in
         the runtime output. The PrivateAssets metadata that enforces that lives on
         the PackageReference in Infrastructure, not here. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>