# GroceryEasy — local development environment.
#
#   cp .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. Every secret here is a throwaway
# placeholder that only ever reaches containers on your own machine. Production
# secrets live in the hosting provider's secret store and are never committed.
#
# .env is gitignored. This file is not — keep it in sync when you add a setting.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=groceryeasy
POSTGRES_PASSWORD=groceryeasy
POSTGRES_DB=groceryeasy
POSTGRES_PORT=5432

# Consumed by the API. Host is "postgres" from inside compose, "localhost" from
# the host machine (e.g. when running the API from an IDE against the container).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=groceryeasy;Username=groceryeasy;Password=groceryeasy

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# ---------------------------------------------------------------------------
# Mail — Mailpit catches everything; no mail leaves your machine.
# Web UI: http://localhost:8025
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
Email__Host=localhost
Email__Port=1025
Email__FromAddress=no-reply@groceryeasy.local
Email__FromName=GroceryEasy

# ---------------------------------------------------------------------------
# Object storage — MinIO locally, Cloudflare R2 in production.
# Identical S3 API, so the application uses one code path for both.
# Console: http://localhost:9001
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=groceryeasy
MINIO_ROOT_PASSWORD=groceryeasy-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_BUCKET=groceryeasy
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=groceryeasy
Storage__SecretKey=groceryeasy-dev-secret
Storage__Bucket=groceryeasy
# Public base URL for serving images. In production this is the R2 custom domain.
Storage__PublicBaseUrl=http://localhost:9000/groceryeasy

# ---------------------------------------------------------------------------
# Telemetry — Aspire dashboard at http://localhost:18888
# ---------------------------------------------------------------------------
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_PORT=18889
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889
OTEL_SERVICE_NAME=groceryeasy-api

# ---------------------------------------------------------------------------
# Authentication
#
# Jwt__Signingkey is a LOCAL PLACEHOLDER. Generate a real one per environment:
#   openssl rand -base64 64
# ---------------------------------------------------------------------------
Jwt__Issuer=https://localhost:8080
Jwt__Audience=groceryeasy-web
Jwt__SigningKey=local-development-only-signing-key-replace-me-with-64-random-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ---------------------------------------------------------------------------
# Application
#
# Frontend__BaseUrl is used to build every emailed link (password reset, email
# verification). It is deliberately configuration and never the Host header —
# see defect L-09 in docs/legacy-audit.md.
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
Frontend__BaseUrl=http://localhost:5173

# ---------------------------------------------------------------------------
# Payments — Razorpay test-mode keys. Leave blank to use the FakePaymentGateway,
# which is the default in Development and the only gateway used by tests.
# ---------------------------------------------------------------------------
Payments__Provider=Fake
Payments__Razorpay__KeyId=
Payments__Razorpay__KeySecret=
Payments__Razorpay__WebhookSecret=
